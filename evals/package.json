{
  "name": "@onlylove/evals",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "tsx benchmark.ts",
    "benchmark:interview:ark": "tsx benchmark.ts --interview",
    "benchmark:extraction:ark": "tsx benchmark.ts --extraction",
    "benchmark:twin:ark": "tsx benchmark.ts --twin",
    "benchmark:matching": "tsx benchmark.ts --matching --deterministic",
    "benchmark:matching:ark": "tsx benchmark.ts --matching",
    "benchmark:context:ark": "tsx benchmark.ts --context",
    "test": "tsx check.ts && tsx benchmark.ts --matching --deterministic",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typebox": "1.1.24",
    "typescript": "5.9.3"
  }
}
