{
  "name": "@onlylove/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:core": "vitest run test/core-api.contract.test.ts",
    "test:ark": "RUN_ARK_INTEGRATION=1 vitest run test/ark.integration.test.ts",
    "test:prepare": "tsx src/prepare-test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.2",
    "@earendil-works/pi-ai": "^0.74.2",
    "@fastify/cookie": "11.0.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
